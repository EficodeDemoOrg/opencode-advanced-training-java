{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env*": "deny",
      "*id_rsa*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*credentials*": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "npm test*": "allow",
      "pnpm test*": "allow",
      "yarn test*": "allow",
      "mvn test*": "allow",
      "mvn clean verify*": "allow",
      "mvn -pl*": "ask",
      "ls*": "allow",
      "pwd*": "allow",
      "cat*": "ask",
      "grep *": "ask"
      "find *": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git checkout -- *": "deny",
      "git branch -D*": "deny",
      "git force*": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "dropdb*": "deny",
      "truncate*": "deny"
    },
      "webfetch": "ask",
    "external_directory": "ask"
  }

}
