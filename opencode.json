{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env*": "deny",
      "*id_rsa*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*credentials*": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "npm test*": "allow",
      "pnpm test*": "allow",
      "yarn test*": "allow",
      "mvn test*": "allow",
      "mvn clean verify*": "allow",
      "ls*": "allow",
      "pwd*": "allow",
      "cat*": "allow",
      "grep *": "allow",

      "Get-ChildItem*": "allow",
      "dir*": "allow",
      "Get-Location*": "allow",
      "Get-Content*": "allow",
      "type *": "allow",
      "Select-String*": "allow",

      "mvn -pl*": "ask",
      "find *": "ask",

      "rm *": "deny",
      "rmdir *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git checkout -- *": "deny",
      "git branch -D*": "deny",
      "git force*": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "dropdb*": "deny",
      "truncate*": "deny",
      "*| xargs rm*": "deny",
      "*| xargs rmdir*": "deny",
      "*; rm *": "deny",
      "*&& rm *": "deny",
      "*|| rm *": "deny",
      "*| sh": "deny",
      "*| sh -*": "deny",
      "*| bash": "deny",
      "*| bash -*": "deny",

      "*Remove-Item*": "deny",
      "*Remove-ItemProperty*": "deny",
      "*Clear-Content*": "deny",
      "*Clear-Item*": "deny",
      "del *": "deny",
      "erase *": "deny",
      "rd *": "deny",
      "*Set-Acl*": "deny",
      "icacls *": "deny",
      "takeown *": "deny",
      "*Invoke-Expression*": "deny",
      "*Set-ExecutionPolicy*": "deny",
      "*Stop-Computer*": "deny",
      "*Restart-Computer*": "deny",
      "*Format-Volume*": "deny",
      "*Clear-Disk*": "deny",
      "*Remove-Partition*": "deny",
      "*-Verb RunAs*": "deny"
    },
    "webfetch": "ask",
    "external_directory": "ask"
  }
}
